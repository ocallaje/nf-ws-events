plugins {
    id 'nf-ws-events@0.1.0'
}

wsEvents {
    enabled = true
    url = ''
    url_register = 'http://localhost:7777/register'
    url_publish = 'http://localhost:7777/publish'
    token = ''
    topic = 'nextflow'
    runId = 2567
    failOnSendError = false

    events {
        workflowEvents  = true
        processStart    = true
        processComplete = true
        processCached   = true
    }
}
